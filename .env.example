# Copy this file to .env and fill in what you use:  cp .env.example .env
# Never commit .env. In GitHub Actions, set these as repository secrets instead.
# Empty values are treated as "not set".

# --- General -----------------------------------------------------------------
# Search conditions (location, keywords, which sites to use)
GETJOB_PROFILE=config/search.yaml
# SQLite file that remembers postings already sent to you
GETJOB_DB_PATH=data/jobs.db
GETJOB_LOG_LEVEL=INFO
# Seconds to wait between requests to the same site (be polite, avoid blocks)
GETJOB_REQUEST_DELAY=2.0
# HTTP timeout in seconds
GETJOB_TIMEOUT=20

# --- Notifications (configure at least one) ----------------------------------
# Telegram: create a bot with @BotFather, send it a message, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email. For Gmail: turn on 2-step verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# --- Official job APIs (optional, more reliable than reading web pages) ------
# 사람인 Open API: https://oapi.saramin.co.kr (apply for an access key)
SARAMIN_API_KEY=
# 고용24 (구 워크넷) 채용정보 Open API: https://www.work24.go.kr (apply for an auth key)
WORK24_API_KEY=

# LinkedIn needs no credentials: only public job listings are read.
# Do NOT put your LinkedIn password anywhere - automated logins get accounts restricted.
